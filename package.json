{
  "name": "claude-token-optimizer",
  "version": "2.3.20",
  "description": "Cut the tokens Claude Code loads at session start. Sets up a small CLAUDE.md with on-demand doc folders, measures real token counts, and keeps it small with audit, prune, and compress.",
  "bin": {
    "cto": "bin/cto.js"
  },
  "main": "src/cli.js",
  "type": "module",
  "files": [
    "bin/",
    "src/",
    "templates/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-md",
    "claudeignore",
    "anthropic",
    "token",
    "token-usage",
    "token-optimization",
    "context-window",
    "context-engineering",
    "llm",
    "ai",
    "ai-coding",
    "coding-agent",
    "agents-md",
    "developer-tools",
    "cli",
    "optimizer",
    "context"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nadimtuhin/claude-token-optimizer#readme",
  "bugs": {
    "url": "https://github.com/nadimtuhin/claude-token-optimizer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nadimtuhin/claude-token-optimizer"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "0.0.4",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "glob": "^14.0.3"
  }
}
